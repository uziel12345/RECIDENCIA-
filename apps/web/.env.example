# URL de la API — apunta al servidor Express
# Producción: VITE_API_URL=https://mapa.ito.edu.mx/api
VITE_API_URL=http://localhost:3001/api

# Host permitido en el servidor de desarrollo de Vite
# Sin definir → acepta cualquier host (ngrok, red local, etc.)
# Definido    → restringe el dev server a ese dominio
# VITE_ALLOWED_HOST=mi-dominio.com
