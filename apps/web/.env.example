# URL de la API. Opcional; por defecto el frontend usa /api.
# Desarrollo directo: VITE_API_URL=http://localhost:3001/api
# Produccion: VITE_API_URL=https://tu-dominio.example/api
VITE_API_URL=http://localhost:3001/api

# Host permitido en el servidor de desarrollo de Vite.
# Opcional; sin definir acepta cualquier host (ngrok, red local, etc.).
# Definido restringe el dev server a ese dominio.
# VITE_ALLOWED_HOST=mi-dominio.example

# Panel local para solicitar GPS y calibrar el marcador v2.
# Mantener en false en producción salvo durante una prueba controlada.
VITE_ENABLE_LOCATION_DEBUG=false
