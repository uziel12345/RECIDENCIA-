# Base de datos
# Host del servidor MySQL. Requerida.
DB_HOST=localhost

# Puerto de MySQL. Opcional, por defecto: 3306.
DB_PORT=3306

# Usuario de MySQL. Requerida.
DB_USER=tu_usuario_aqui

# Password de MySQL. Requerida.
DB_PASSWORD=tu_password_aqui

# Nombre de la base de datos. Requerida.
DB_NAME=tu_base_de_datos_aqui


# JWT/Auth
# Secreto para firmar tokens JWT. Requerida, minimo 32 caracteres.
# Genera uno seguro con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=pega_un_secreto_seguro_de_64_caracteres_aqui

# Tiempo de expiracion del JWT. Requerida.
JWT_EXPIRES_IN=8h


# CSRF
# Secreto separado para tokens CSRF. Opcional; por defecto usa JWT_SECRET.
# Recomendado en produccion, minimo 32 caracteres si se define.
# Genera uno seguro con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=pega_otro_secreto_seguro_de_64_caracteres_aqui


# Servidor
# Puerto HTTP del API. Opcional, por defecto: 3001.
PORT=3001

# Entorno de ejecucion. Opcional; si no se define, el servidor se comporta como desarrollo.
NODE_ENV=development


# CORS
# Origen permitido para el frontend. Opcional, por defecto: http://localhost:5173.
CORS_ORIGIN=http://localhost:5173
