# Base de datos
# Host del servidor PostgreSQL. Requerida.
DB_HOST=localhost

# Puerto de PostgreSQL. Opcional, por defecto: 5432.
DB_PORT=5432

# Usuario de PostgreSQL. Requerida.
DB_USER=tu_usuario_aqui

# Password de PostgreSQL. Requerida.
DB_PASSWORD=tu_password_aqui

# Nombre de la base de datos. Requerida.
DB_NAME=tu_base_de_datos_aqui

# Limites defensivos del pool y de consultas PostgreSQL.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000


# JWT/Auth
# Secreto para firmar tokens JWT. Requerida, minimo 32 caracteres.
# Genera uno seguro con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=pega_un_secreto_seguro_de_64_caracteres_aqui

# Tiempo de expiracion del JWT. Requerida.
JWT_EXPIRES_IN=8h

# Identidad esperada de los tokens (issuer/audience).
JWT_ISSUER=mapa-ito-api
JWT_AUDIENCE=mapa-ito-admin


# CSRF
# Secreto separado para tokens CSRF. Obligatorio en produccion, minimo 32 caracteres.
# Genera uno seguro con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=pega_otro_secreto_seguro_de_64_caracteres_aqui


# Servidor
# Puerto HTTP del API. Opcional, por defecto: 3001.
PORT=3001

# Interfaz de escucha. En producción detrás de un proxy: 127.0.0.1.
# Para desarrollo y acceso directo desde la red: 0.0.0.0.
HOST=127.0.0.1

# Entorno de ejecucion. Opcional; si no se define, el servidor se comporta como desarrollo.
NODE_ENV=development


# CORS
# Origen permitido para el frontend. Opcional, por defecto: http://localhost:5173.
CORS_ORIGIN=http://localhost:5173
